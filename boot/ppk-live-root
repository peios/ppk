#!/usr/bin/sh
# /// hook
# contributes = ["rootfs-ready"]
# ///
#
# Live boot: find the medium this initramfs was built for, mount the live
# system's /usr from the image it holds, on a root of a fresh tmpfs, and
# offer the root to prelude at /mnt/rootfs.
#
# The hook contributes to rootfs-ready, as every hook that prepares the
# root does: coldplug's driver loading contributes alongside it, so the
# medium's driver may load while this hook waits for the medium.
#
# The initramfs names its medium in /system/medium. The medium holds the
# same identifier in /peios-medium, beside the live system's image,
# /live.sqfs, what its root holds outside /usr, /live.layout, and its store,
# /artifacts. It is found by trying each disk, disc and stick with an
# ISO9660 filesystem, so that it boots however it is attached, and the
# identifier keeps another Peios medium attached alongside from being taken
# for it.
#
# The image is the live system's closure as a squashfs, carrying each
# file's security descriptor and signature, which ISO9660 can't. The
# initramfs holds its SHA-256 in /system/live-image, and the image must
# match it before it's mounted. The root lives on its own tmpfs because
# prelude deletes what is left on the initramfs's filesystem once it hands
# over. The medium is moved into the root, where the image's loop device
# keeps reading it and an installer reads its store. The root's own
# skeleton file then gives it what it needs outside /usr.

# prelude installs its hook logger at this path on the booted system.
# shellcheck source=/dev/null
. /usr/libexec/prelude/hook-log.sh
hook_log_init ppk-live-root

medium=/mnt/medium
live=/mnt/live
rootfs=/mnt/rootfs
# Seconds to wait for the medium, which on a USB stick can appear well
# into boot.
wait=10

if ! read -r want </system/medium; then
    # This hook is the image's root strategy, so a missing input is a
    # failure, not a reason to decline.
    log_fail "no medium named in /system/medium"
    exit 1
fi

# Mounts the medium named $want at $medium, trying each block device that
# might hold it. Fails if none does.
find_medium() {
    for dev in /dev/sr* /dev/sd* /dev/vd* /dev/nvme*n* /dev/mmcblk*; do
        [ -b "$dev" ] || continue
        mount -t iso9660 -o ro "$dev" "$medium" 2>/dev/null || continue
        if read -r found <"$medium/peios-medium" && [ "$found" = "$want" ]; then
            log "found the medium on $dev"
            return 0
        fi
        umount "$medium"
    done 2>/dev/null
    return 1
}

mkdir -p "$medium" || exit 1
waited=0
until find_medium; do
    if [ "$waited" -ge "$wait" ]; then
        log_fail "medium $want not found"
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

image=$medium/live.sqfs
if ! read -r image_hash </system/live-image; then
    log_fail "no image named in /system/live-image"
    exit 1
fi
log "checking the live system's image"
sum=$(sha256sum "$image") || exit 1
if [ "${sum%% *}" != "$image_hash" ]; then
    log_fail "$image is not the image this initramfs was built for"
    exit 1
fi

mkdir -p "$live" || exit 1
mount -t tmpfs tmpfs "$live" || exit 1
# A tmpfs has no security descriptor until its mounter gives it one, and
# until then refuses everyone.
seed-sd "$live" || exit 1
# prelude moves /proc, /sys and /dev into the new root, so the root has
# them whatever else it holds.
for dir in usr proc sys dev; do
    mkdir -p "$live/root/$dir" || exit 1
done
mount --bind "$live/root" "$rootfs" || exit 1
# Every file and directory of the image carries its descriptor, so a
# missing one is a fault, as the mount's default policy has it.
if ! mount -t squashfs -o loop,ro "$image" "$rootfs/usr"; then
    log_fail "could not mount the live system's image"
    exit 1
fi
# What the spec gives the root outside /usr: links, such as /bin into
# /usr, and empty directories.
while read -r kind path target; do
    case $kind in
    l) ln -s "$target" "$rootfs/$path" || exit 1 ;;
    d) mkdir -p "$rootfs/$path" || exit 1 ;;
    *)
        log_fail "$medium/live.layout: $kind: not l or d"
        exit 1
        ;;
    esac
done <"$medium/live.layout" || exit 1
# A package holds only /usr. What the root needs outside it, /var, /lcl,
# /tmp and the /lib64 link to the loader, is in the root skeleton file
# fsbase ships, which the root builder applies (PSPU 11). Without one the
# root has only what its packages and the layout give it.
skeleton=$rootfs/usr/share/skeleton
if [ -e "$skeleton" ]; then
    if ! skeleton apply "$rootfs"; then
        log_fail "could not apply the root skeleton"
        exit 1
    fi
else
    log_warn "the system root has no skeleton file, /usr/share/skeleton; nothing outside /usr but what its layout gives"
fi
# Image policy is outside /usr, so it travels beside the image rather
# than in a package. Preserve the autorun scripts' executable modes.
if [ -d "$medium/lcl" ]; then
    log "copying the medium's local policy into the system root"
    if ! cp -a "$medium/lcl" "$rootfs/"; then
        log_fail "could not copy the medium's local policy"
        exit 1
    fi
fi
# The medium stays mounted, read-only, at /media/peios in the system root:
# the image's loop device reads it, and an installer composes an installed
# system from the packages its store holds, which are more than the live
# system's.
mkdir -p "$rootfs/media/peios" || exit 1
mount --move "$medium" "$rootfs/media/peios" || exit 1
log_ok "system root at $rootfs, with /usr from the medium's image and the medium at /media/peios"
