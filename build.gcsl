# ppk, each crate compiled on its own (see the rust library's `workspace`):
# a static, position-independent musl program, which an initramfs runs
# before any C library is there.
import "github.com/gcslib/rust"

# What a workspace that takes ppk's crates needs to build them: the
# kernel's `peios-uapi`, which ppk vendors, takes its types from a file of
# the kernel's sources around it, through `#[path]`, so the file is placed
# where that path reaches, wherever the crate is.
def crate_settings() -> List<rust.CrateSettings> {
    = [{
        package = "peios-uapi"
        beside = [{
            at = "../../../security/pkm/kacs/peios_uapi.rs"
            place = file("vendor/kernel/security/pkm/kacs/peios_uapi.rs")
        }]
    }]
}

# The ppk workspace, planned for musl, linked with full RELRO.
def crates() -> rust.RustWorkspace {
    let target = "x86_64-unknown-linux-musl"
    = rust.workspace(
        dir("."),
        rust.vendored(file("Cargo.lock")),
        target = target,
        rustflags = [...rust.default_rustflags(target), "-Clink-arg=-Wl,-z,relro", "-Clink-arg=-Wl,-z,now"],
        crates = crate_settings(),
    )
}

# The package tool.
def build ppk() {
    = rust.bin(crates(), "ppk")
}
