#!/bin/bash
# Live-boot a Peios ISO into a system composed from ppk packages, for trying
# ppk by hand. pekit builds busybox, ppk, prelude and a prelude hook from
# their recipes in pkgs, and peiso builds an ISO from them, which QEMU boots
# under UEFI. At boot, prelude runs the hook, which composes the system's
# root from packages on a tmpfs, and hands over to it. The guest is a
# throwaway: nothing in it survives.
set -euo pipefail

readonly DEFAULT_KERNEL_RELEASE=7.0.9-peios-0.21.0-alpha11
readonly DEFAULT_KERNEL="$HOME/.cache/provium/builds/peinit/image/root/usr/lib/modules/$DEFAULT_KERNEL_RELEASE/vmlinuz-$DEFAULT_KERNEL_RELEASE"
readonly DEFAULT_PEIOS_SDK="$HOME/.cache/peios/prelude-sdk-musl"
# UEFI firmware for QEMU, from the host's OVMF package: its code, and the
# variables each boot starts from.
readonly OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
readonly OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd

usage() {
    cat <<'EOF'
Boot a Peios ISO built from ppk packages

Usage: tools/vm-shell [options]

Options:
  --kernel <file>  Boot this kernel (default: $PPK_VM_KERNEL, or the cached
                   full-system test image's kernel)
  --mkirf <file>   Build the initramfs with this mkirf (default: one built
                   from the peiosutils repository beside ppk)
  --mkuki <file>   Build the UKI with this mkuki (default: one built from
                   the peiosutils repository beside ppk)
  --peiso <file>   Build the ISO with this peiso (default: one built from
                   the peiso repository beside ppk)
  --pkgs <dir>     Build the packages from the recipes in this workspace
                   (default: the pkgs repository beside ppk); its recipes
                   build ppk and prelude from the checkouts beside it
  --pekit <file>   Build the packages with this pekit (default: one built
                   from the pekit repository beside ppk)
  --sdk <dir>      Build seed-sd against this static musl Peios SDK
                   (default: $PEIOS_SDK, or ~/.cache/peios/prelude-sdk-musl)
  --memory <size>  Give the guest this much memory (default: 1G)
  -h, --help       Print help

Run 'poweroff -f' in the guest to power it off, or press Ctrl-A then X.
Exiting the guest's shell halts it; press Ctrl-A then X to leave QEMU.
EOF
}

usage_error() {
    echo "vm-shell: $1" >&2
    echo "Try 'tools/vm-shell --help' for more information." >&2
    exit 2
}

fail() {
    echo "vm-shell: $1" >&2
    exit 1
}

kernel=${PPK_VM_KERNEL:-$DEFAULT_KERNEL}
mkirf=
mkuki=
peiso=
pkgs=
pekit=
sdk=${PEIOS_SDK:-$DEFAULT_PEIOS_SDK}
memory=1G
while (($#)); do
    case $1 in
        --kernel | --mkirf | --mkuki | --peiso | --pkgs | --pekit | --sdk | --memory)
            (($# >= 2)) || usage_error "missing argument for '$1'"
            option=${1#--}
            printf -v "$option" '%s' "$2"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage_error "unknown option '$1'"
            ;;
    esac
done

[[ -f $kernel ]] || fail "$kernel: No such file"
[[ -f $OVMF_CODE && -f $OVMF_VARS ]] || fail "$OVMF_CODE: No such file; install OVMF"

repo=$(cd -- "$(dirname -- "$0")/.." && pwd)

# Builds the tool $1 from the repository $2 beside ppk with cargo's
# arguments after it, unless it was given, and checks it can be run.
tool() {
    local name=$1 dir=$repo/../$2
    shift 2
    if [[ -z ${!name} ]]; then
        [[ -f $dir/Cargo.toml ]] || fail "$dir: No such repository; pass --$name"
        cargo build --quiet --release --manifest-path "$dir/Cargo.toml" "$@"
        printf -v "$name" '%s' "$dir/target/release/$name"
    fi
    [[ -x ${!name} ]] || fail "${!name}: not executable"
}
tool mkirf peiosutils --package pu_mkirf
tool mkuki peiosutils --package pu_mkuki
tool peiso peiso
tool pekit pekit

pkgs=${pkgs:-$repo/../pkgs}
[[ -f $pkgs/workspace.gcsl ]] || fail "$pkgs: No such recipe workspace; pass --pkgs"

work=$(mktemp -d "${TMPDIR:-/tmp}/ppk-vm-shell.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT HUP INT TERM

# The packages, built from their recipes into a store of this run's own.
# ppk's and prelude's recipes build from local checkouts, whose versions do
# not change with their contents, so a store kept between runs would refuse
# what they make next; with one version of each, the spec needs none.
# prelude's recipe takes the SDK seed-sd links from $PEIOS_SDK; prelude's
# docs/building.md says how to prepare it.
PEIOS_SDK=$sdk "$pekit" package --workspace "$pkgs" --artifact-dir "$work/artifacts" \
    net.busybox.busybox dev.peios.ppk dev.peios.prelude dev.peios.live-root >/dev/null

# The live system is busybox and ppk. The initramfs adds prelude, its
# init, and the hook that composes the live system; peiso puts the live
# system's packages there too, for the hook to compose it from. rd.shell
# makes prelude open its recovery shell if boot fails.
cat >"$work/spec.toml" <<EOF
disable_default_repos = true

[[repository]]
filepath = "artifacts"

[kernel]
file = "$kernel"
cmdline = "console=ttyS0 panic=-1 quiet rd.shell"

[[package]]
name = "net.busybox.busybox"

[[package]]
name = "dev.peios.ppk"

[[package]]
name = "dev.peios.prelude"
liveboot = false
initramfs = true

[[package]]
name = "dev.peios.live-root"
liveboot = false
initramfs = true
EOF
"$peiso" build "$work/spec.toml" --out "$work/peios.iso" --mkirf "$mkirf" --mkuki "$mkuki" \
    >/dev/null 2>"$work/peiso.log" || {
    cat "$work/peiso.log" >&2
    exit 1
}
cp -- "$OVMF_VARS" "$work/ovmf-vars.fd"

cat <<HINT

QEMU boots the ISO under UEFI. prelude, the initramfs's init, runs the
ppk-live-root hook, which composes the system's root from busybox and ppk
on a tmpfs and hands it to prelude. The system's init is busybox's: press
Enter for a shell. ppk is /usr/bin/ppk, and the system's packages are in
/system/artifacts. If boot fails, prelude opens a recovery shell instead.

Run 'poweroff -f' to power off, or press Ctrl-A then X.

HINT

qemu-system-x86_64 \
    -enable-kvm -cpu host -m "$memory" -machine q35 \
    -nographic -no-reboot \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$work/ovmf-vars.fd" \
    -cdrom "$work/peios.iso"
