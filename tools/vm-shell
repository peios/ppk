#!/bin/bash
# Live-boot a Peios kernel into a system composed from ppk packages, for
# trying ppk by hand. The host packs busybox, ppk, prelude and a prelude
# hook, composes them into the initramfs's root, and has mkirf turn that
# into the initramfs. At boot, prelude runs the hook, which composes the
# system's root from packages on a tmpfs, and hands over to it. The guest
# is a throwaway: nothing in it survives.
set -euo pipefail

readonly MUSL_TARGET=x86_64-unknown-linux-musl
readonly DEFAULT_KERNEL_RELEASE=7.0.9-peios-0.21.0-alpha11
readonly DEFAULT_KERNEL="$HOME/.cache/provium/builds/peinit/image/root/usr/lib/modules/$DEFAULT_KERNEL_RELEASE/vmlinuz-$DEFAULT_KERNEL_RELEASE"
readonly DEFAULT_PEIOS_SDK="$HOME/.cache/peios/prelude-sdk-musl"

usage() {
    cat <<'EOF'
Boot a Peios kernel with an initramfs built from a ppk closure

Usage: tools/vm-shell [options]

Options:
  --kernel <file>  Boot this kernel (default: $PPK_VM_KERNEL, or the cached
                   full-system test image's kernel)
  --mkirf <file>   Build the initramfs with this mkirf (default: one built
                   from the peiosutils repository beside ppk)
  --prelude <dir>  Build prelude from this checkout (default: the prelude
                   repository beside ppk)
  --sdk <dir>      Build seed-sd against this static musl Peios SDK
                   (default: $PEIOS_SDK, or ~/.cache/peios/prelude-sdk-musl)
  --memory <size>  Give the guest this much memory (default: 1G)
  -h, --help       Print help

Run 'poweroff -f' in the guest to power it off, or press Ctrl-A then X.
Exiting the guest's shell halts it; press Ctrl-A then X to leave QEMU.
EOF
}

usage_error() {
    echo "vm-shell: $1" >&2
    echo "Try 'tools/vm-shell --help' for more information." >&2
    exit 2
}

fail() {
    echo "vm-shell: $1" >&2
    exit 1
}

kernel=${PPK_VM_KERNEL:-$DEFAULT_KERNEL}
mkirf=
prelude=
sdk=${PEIOS_SDK:-$DEFAULT_PEIOS_SDK}
memory=1G
while (($#)); do
    case $1 in
        --kernel)
            (($# >= 2)) || usage_error "missing argument for '--kernel'"
            kernel=$2
            shift 2
            ;;
        --mkirf)
            (($# >= 2)) || usage_error "missing argument for '--mkirf'"
            mkirf=$2
            shift 2
            ;;
        --prelude)
            (($# >= 2)) || usage_error "missing argument for '--prelude'"
            prelude=$2
            shift 2
            ;;
        --sdk)
            (($# >= 2)) || usage_error "missing argument for '--sdk'"
            sdk=$2
            shift 2
            ;;
        --memory)
            (($# >= 2)) || usage_error "missing argument for '--memory'"
            memory=$2
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage_error "unknown option '$1'"
            ;;
    esac
done

[[ -f $kernel ]] || fail "$kernel: No such file"
busybox=$(command -v busybox) || fail "busybox: not found on PATH"
# The guest has no libraries, so busybox must be statically linked.
if ldd "$busybox" >/dev/null 2>&1; then
    fail "$busybox: not statically linked"
fi
# The first line of busybox's help is "BusyBox v1.37.0 (...) multi-call binary."
busybox_version=$("$busybox" | sed -n '1s/^BusyBox v\([0-9][0-9.]*\).*/\1/p')
[[ -n $busybox_version ]] || fail "$busybox: cannot read its version"

repo=$(cd -- "$(dirname -- "$0")/.." && pwd)
cargo build --quiet --release --target "$MUSL_TARGET" --manifest-path "$repo/Cargo.toml"
ppk=$repo/target/$MUSL_TARGET/release/ppk
ppk_version=$("$ppk" --version | sed -n 's/^ppk //p')

if [[ -z $mkirf ]]; then
    peiosutils=$repo/../peiosutils
    [[ -f $peiosutils/Cargo.toml ]] || fail "$peiosutils: No such repository; pass --mkirf"
    cargo build --quiet --release --package pu_mkirf --manifest-path "$peiosutils/Cargo.toml"
    mkirf=$peiosutils/target/release/mkirf
fi
[[ -x $mkirf ]] || fail "$mkirf: not executable"

prelude=${prelude:-$repo/../prelude}
[[ -f $prelude/Cargo.toml ]] || fail "$prelude: No such repository; pass --prelude"
# seed-sd links the static libpeios; prelude's docs/building.md says how to
# prepare the SDK with its tools/prepare-sdk.py.
[[ -f $sdk/TARGET && $(<"$sdk/TARGET") == "$MUSL_TARGET" ]] ||
    fail "$sdk: not a prepared $MUSL_TARGET Peios SDK; pass --sdk"
# Build from inside the checkout, so that its own pinned toolchain is used.
(
    cd -- "$prelude"
    export PEIOS_LIB_DIR=$sdk/lib PEIOS_INCLUDE=$sdk/include PKM_UAPI=$sdk/include
    gcc_include=$(cc -print-file-name=include)
    export BINDGEN_EXTRA_CLANG_ARGS="-isystem $gcc_include"
    cargo build --quiet --release --target "$MUSL_TARGET" --package prelude --package seed-sd
)
prelude_version=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version *= *"\(.*\)"/\1/p' "$prelude/Cargo.toml")
[[ -n $prelude_version ]] || fail "$prelude/Cargo.toml: cannot read the version"

work=$(mktemp -d "${TMPDIR:-/tmp}/ppk-vm-shell.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT HUP INT TERM

# The packages, staged with paths relative to /usr. busybox gets a link to
# itself for each applet.
mkdir -p -- "$work/busybox/bin" "$work/ppk/bin" \
    "$work/prelude/bin" "$work/prelude/sbin" "$work/prelude/libexec/prelude" \
    "$work/live-root/libexec/prelude/hooks.d"
cp -- "$busybox" "$work/busybox/bin/busybox"
"$busybox" --list | while read -r applet; do
    # Some builds list busybox itself as an applet.
    [[ $applet == busybox ]] || ln -s busybox "$work/busybox/bin/$applet"
done
cp -- "$ppk" "$work/ppk/bin/ppk"
# prelude's own install layout. prelude runs seed-sd on /dev, and its hooks
# source the logging helper.
cp -- "$prelude/target/$MUSL_TARGET/release/prelude" "$work/prelude/sbin/prelude"
cp -- "$prelude/target/$MUSL_TARGET/release/seed-sd" "$work/prelude/bin/seed-sd"
install -m 644 -- "$prelude/src/hook-log.sh" "$work/prelude/libexec/prelude/hook-log.sh"
# The live-boot root strategy: a prelude hook that composes the system's
# root at boot.
install -m 755 -- "$repo/boot/ppk-live-root" "$work/live-root/libexec/prelude/hooks.d/ppk-live-root"

artifacts=$work/artifacts
busybox_package=dev.peios.busybox@$busybox_version
ppk_package=dev.peios.ppk@$ppk_version
prelude_package=dev.peios.prelude@$prelude_version
live_root_package=dev.peios.live-root@$ppk_version
"$ppk" pack "$busybox_package" "$work/busybox" --artifact-dir "$artifacts" >/dev/null
"$ppk" pack "$ppk_package" "$work/ppk" --artifact-dir "$artifacts" >/dev/null
"$ppk" pack "$prelude_package" "$work/prelude" --artifact-dir "$artifacts" >/dev/null
"$ppk" pack "$live_root_package" "$work/live-root" --artifact-dir "$artifacts" >/dev/null

# The system that runs after prelude hands over. The hook composes its root
# from the initramfs's store, which holds only the initramfs's own packages,
# so these must be among them.
system=("$busybox_package" "$ppk_package")
initramfs=("$busybox_package" "$ppk_package" "$prelude_package" "$live_root_package")

# The initramfs environment: the packages as /usr, with their artifacts for
# the hook and for ppk in the recovery shell. prelude is init, and mounts
# /proc and /sys on these directories; mkirf turns the hook into prelude's
# hook sequence.
root=$work/root
"$ppk" compose-env "${initramfs[@]}" --artifact-dir "$artifacts" --out "$root" \
    --include-artifacts --symlink init::sbin/prelude \
    --dir proc --dir sys --dir tmp >/dev/null

# mkirf reports what it wrote; show its output only when it fails.
if ! built=$("$mkirf" "$root" "$work/initramfs.cpio.zst" 2>&1); then
    printf '%s\n' "$built" >&2
    exit 1
fi

cat <<HINT

prelude, the initramfs's init, runs the ppk-live-root hook, which composes
the system's root from ${system[*]}
on a tmpfs and hands it to prelude. The system's init is busybox's: press
Enter for a shell. ppk is /usr/bin/ppk, and the system's packages are in
/system/artifacts. If boot fails, prelude opens a recovery shell instead.

Run 'poweroff -f' to power off, or press Ctrl-A then X.

HINT

# The hook reads the system's packages from ppk.system=, and rd.shell makes
# prelude open its recovery shell if boot fails.
system_arg=$(IFS=,; echo "${system[*]}")
qemu-system-x86_64 \
    -enable-kvm -cpu host -m "$memory" \
    -nographic -no-reboot \
    -kernel "$kernel" \
    -initrd "$work/initramfs.cpio.zst" \
    -append "console=ttyS0 panic=-1 quiet rd.shell ppk.system=$system_arg"
